# Redirect any request for a .php path to the same path with .html
# Example: /path/file.php -> /path/file.html
# Return a 301 (permanent) redirect.

RewriteEngine On

# If you want to redirect even when a .php file exists, use the rule below.
RewriteRule ^(.*)\.php$ /$1.html [R=301,L]

# If you prefer to only redirect when the .php file does NOT exist on disk, use:
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteRule ^(.*)\.php$ /$1.html [R=301,L]
  
